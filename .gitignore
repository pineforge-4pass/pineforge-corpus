# Compiled per-strategy shared libraries — platform-specific build artefacts,
# regenerated locally by scripts/run_corpus.sh. The transpiler output
# (generated.cpp) is shipped in-tree so public users can rebuild without
# needing the closed-source pineforge-codegen transpiler.
**/strategy.dylib
**/strategy.so
**/strategy.dll
**/fingerprint.json

# Chart feeds derived locally from the single committed 1m feed by the
# engine repo's scripts/derive_corpus_feeds.py
data/derived/

# oh-my-claudecode operational state
.omc/

# Claude Code worktrees. Local-only scratch checkouts: these were previously
# committed as bare gitlinks with no matching .gitmodules entry, which made
# `git clone --recurse-submodules` fail for every consumer of this repo
# ("fatal: No url found for submodule path 'corpus/.claude/worktrees/feat-A'").
.claude/worktrees/
